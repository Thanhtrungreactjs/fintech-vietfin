generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: status/type fields use String instead of native enum so this schema
// stays portable between SQLite (dev) and PostgreSQL (production) — Prisma's
// SQLite connector does not support native enums. Allowed values are listed
// in comments next to each field.

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String   @default("PERSONAL") // PERSONAL | BUSINESS
  kycStatus    String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  kyc            KycDocument?
  wallet         Wallet?
  loanApps       LoanApplication[]
  policies       InsurancePolicy[]
  invoices       Invoice[]
  ledgerEntries  LedgerEntry[]
  budgets        Budget[]
  termDeposits   TermDeposit[]
  topUpIntents   TopUpIntent[]
  tradingPositions TradingPosition[]
  tradingOrders    TradingOrder[]
}

model KycDocument {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  idType      String // NATIONAL_ID | PASSPORT
  idNumber    String
  dob         String
  address     String
  status      String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Float    @default(0)
  currency  String   @default("VND")
  createdAt DateTime @default(now())

  transactions       Transaction[] @relation("WalletTransactions")
  incomingTransfers  Transaction[] @relation("CounterpartyTransactions")
}

model Transaction {
  id               String   @id @default(uuid())
  walletId         String
  wallet           Wallet   @relation("WalletTransactions", fields: [walletId], references: [id])
  type             String // DEPOSIT | WITHDRAW | TRANSFER_IN | TRANSFER_OUT | LOAN_DISBURSEMENT | LOAN_REPAYMENT | INSURANCE_PREMIUM | INSURANCE_PAYOUT
  amount           Float
  balanceAfter     Float
  status           String   @default("COMPLETED") // COMPLETED | FAILED
  category         String   @default("Khác")
  description      String?
  idempotencyKey   String?  @unique
  counterpartyWalletId String?
  counterpartyWallet   Wallet? @relation("CounterpartyTransactions", fields: [counterpartyWalletId], references: [id])
  createdAt        DateTime @default(now())
}

model LoanApplication {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Float
  purpose       String
  termMonths    Int
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | ACTIVE | CLOSED | DEFAULTED
  creditScore   Int? // algorithm's suggested score, shown to the admin as decision support
  interestRate  Float? // annual %, set by the admin at approval time (may differ from the suggested rate)
  decisionNote  String?
  reviewedByAdminId String? // which admin approved/rejected this application
  disbursementBank          String? // VietQR bank/e-wallet code chosen for disbursement, e.g. TPB, MB, momo
  disbursementBankName      String?
  disbursementAccountNumber String?
  createdAt     DateTime @default(now())
  decisionAt    DateTime?
  disbursedAt   DateTime?

  schedule LoanRepaymentSchedule[]
}

model LoanRepaymentSchedule {
  id            String   @id @default(uuid())
  loanId        String
  loan          LoanApplication @relation(fields: [loanId], references: [id])
  periodNumber  Int
  dueDate       DateTime
  principalDue  Float
  interestDue   Float
  lateFee       Float    @default(0)
  status        String   @default("UPCOMING") // UPCOMING | PAID | OVERDUE
  paidAt        DateTime?
}

model InsurancePlan {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String // real, actually-marketed product name
  insurer       String // real insurance company underwriting this product
  insurerLogo   String? // company logo URL
  category      String // HEALTH | VEHICLE | HOME | TRAVEL | LIFE
  baseRate      Float // % of sum insured per year
  description   String?
  highlights    String? // JSON array of coverage highlight bullets
  termMonths    Int      @default(12)
  minSumInsured Float?
  maxSumInsured Float?

  policies InsurancePolicy[]
}

model InsurancePolicy {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  planId       String
  plan         InsurancePlan @relation(fields: [planId], references: [id])
  subjectInfo  String // JSON blob describing insured subject
  sumInsured   Float
  premium      Float
  riskScore    Int?
  status       String   @default("ACTIVE") // ACTIVE | CANCELLED | EXPIRED
  startDate    DateTime @default(now())
  endDate      DateTime
  createdAt    DateTime @default(now())

  claims InsuranceClaim[]
}

model InsuranceClaim {
  id              String   @id @default(uuid())
  policyId        String
  policy          InsurancePolicy @relation(fields: [policyId], references: [id])
  description     String
  amountRequested Float
  amountApproved  Float?
  status          String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | PAID
  submittedAt     DateTime @default(now())
  decisionAt      DateTime?
}

model Invoice {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  symbol        String // ký hiệu hoá đơn, VD: 1C25TT
  number        String   @unique // số hoá đơn, VD: INV-000123
  counterparty  String // tên đơn vị/khách hàng mua
  buyerTaxCode  String?
  buyerAddress  String?
  paymentMethod String   @default("TRANSFER") // TRANSFER | CASH
  vatRate       Float    @default(10) // % thuế GTGT áp dụng cho toàn bộ hoá đơn
  subtotal      Float // tổng tiền hàng trước thuế (tổng thành tiền các dòng hàng hoá)
  vatAmount     Float // tiền thuế GTGT = subtotal * vatRate / 100
  amount        Float // tổng cộng thanh toán = subtotal + vatAmount
  note          String?
  status        String   @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE
  issueDate     DateTime @default(now())
  dueDate       DateTime
  paidAt        DateTime?

  items InvoiceItem[]
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String // tên hàng hoá/dịch vụ
  unit      String // đơn vị tính, VD: cái, giờ, tháng
  quantity  Float
  unitPrice Float
  lineTotal Float // quantity * unitPrice
}

model LedgerEntry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  source      String // WALLET | LOAN | INSURANCE | INVOICE | DEPOSIT | TRADING
  sourceRefId String?
  type        String // INCOME | EXPENSE
  amount      Float
  description String?
  occurredAt  DateTime @default(now())
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  category    String
  limitAmount Float
  month       String // YYYY-MM
  createdAt   DateTime @default(now())
}

model TermDeposit {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  bankCode     String // VietQR bank code, e.g. VCB, TCB, MB
  bankName     String
  principal    Float
  termMonths   Int
  interestRate Float // annual % for the full term, locked in at opening
  status       String    @default("ACTIVE") // ACTIVE | MATURED | WITHDRAWN | WITHDRAWN_EARLY
  startDate    DateTime  @default(now())
  maturityDate DateTime
  settledAt    DateTime?
  interestPaid Float?
  createdAt    DateTime  @default(now())
}

// A pending real-money top-up request: the unique `code` is embedded in the
// VietQR transfer content so an incoming-payment webhook (e.g. SePay) can be
// matched back to the user who requested it and auto-credit their wallet.
model TopUpIntent {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  code        String    @unique
  status      String    @default("PENDING") // PENDING | COMPLETED | EXPIRED
  matchedTxId String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// Simulated ("paper") trading: no real asset custody or exchange order is
// ever placed — buys/sells are matched instantly against a live reference
// price and settled against the user's own VND wallet balance.
model TradingPosition {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  symbol        String // e.g. BTCUSDT
  quantity      Float
  avgEntryPrice Float
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([userId, symbol])
}

model TradingOrder {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  symbol      String
  side        String // BUY | SELL
  quantity    Float
  price       Float
  amount      Float // quantity * price, in VND
  realizedPnl Float?  // only set on SELL orders that reduce/close a position
  createdAt   DateTime @default(now())
}
